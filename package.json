{
  "name": "our-wellness-client-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "create-client": "tsx scripts/create-client.ts",
    "import-campaigns": "tsx scripts/import-campaigns.ts",
    "set-clinic-location": "tsx scripts/set-clinic-location.ts",
    "import-network-records": "tsx scripts/import-network-records.ts",
    "refresh-network-map": "tsx scripts/refresh-network-map.ts",
    "route-requests": "tsx scripts/route-requests.ts",
    "import-field-log": "tsx scripts/import-field-log.ts",
    "make-demo-field-log": "tsx scripts/make-demo-field-log.ts",
    "make-demo-account": "tsx scripts/make-demo-account.ts",
    "add-staff-login": "tsx scripts/add-staff-login.ts",
    "release-businesses": "tsx scripts/release-businesses.ts",
    "geocode-release": "tsx scripts/geocode-release.ts",
    "activate-live": "tsx scripts/activate-live.ts",
    "set-password": "tsx scripts/set-password.ts",
    "list-logins": "tsx scripts/list-logins.ts",
    "plan-round": "tsx scripts/plan-round.ts",
    "make-sample-outreach": "tsx scripts/make-sample-outreach.ts",
    "name-login": "tsx scripts/name-login.ts",
    "remove-login": "tsx scripts/remove-login.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
