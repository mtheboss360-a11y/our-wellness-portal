{
  "name": "our-wellness-client-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "create-client": "tsx scripts/create-client.ts",
    "import-campaigns": "tsx scripts/import-campaigns.ts",
    "set-clinic-location": "tsx scripts/set-clinic-location.ts",
    "import-network-records": "tsx scripts/import-network-records.ts",
    "import-map-places": "tsx scripts/import-map-places.ts",
    "prune-map": "tsx scripts/prune-map.ts",
    "refresh-network-map": "tsx scripts/refresh-network-map.ts",
    "route-requests": "tsx scripts/route-requests.ts",
    "import-field-log": "tsx scripts/import-field-log.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
