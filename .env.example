# Copy to .env for local use. No credentials belong in this file.
PORT=3000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=var/portal.sqlite
ENABLE_SAMPLE_DATA=true
TRUST_PROXY=false
# Network Map. The Google Places key is set in the Render dashboard under this exact,
# case-sensitive name — never in this file and never in source control. Without it the map
# shows an honest empty state rather than invented businesses.
# Google_places_API=
# Set to false to stop the portal looking businesses up on its own; refresh from the terminal
# with: npm run refresh-network-map -- --clinic clinic-slug
# NETWORK_MAP_AUTO_DISCOVER=true
# For public hosting: NODE_ENV=production, ENABLE_SAMPLE_DATA=false,
# APP_ORIGIN=https://portal.your-domain.com, behind an HTTPS reverse proxy.
# Only set TRUST_PROXY=true if the proxy overwrites X-Forwarded-For and direct
# access to this Node server is blocked.
